# ── 依赖与运行时 ─────────────────────────────
node_modules/
ms-playwright/

# ── 便携版打包产物（体积大，由 build-portable.ps1 生成）──
dist/

# ── 浏览器用户数据（含 Cookies / 登录数据）──
browser-profile/
browser-profile-cdp/
browser-profile-edge/
browser-profile-firefox/

# ── 会话 / 登录态 / Cookie / 凭据（禁止提交）──
session/
# 用 config/* 而不是 config/：写成 config/ 会排除整个目录，
# git 不会进入被排除的目录，后面的 ! 白名单永远不生效（模板也会被挡掉）。
config/*
!config/account.template.json
_temp/
.session-archive/
.acl-recovery/
.acl-reports/
*.zip
dsh-session-*

# ── 文档（要保留；上面的 export/*.md 已忽略导出稿）──
!README.md
!HANDOFF.md
!SITE-REPORT.md
!DOMAIN-REPORT.md
!docs/
!docs/**

# ── 采集与导出产物（含个人数据 / 截图，仅保留脚本）──
recon/*/
recon/*.json
recon/*.txt
recon/*.log
export/*/
export/*.json
export/*.md
export/*.html
export/*.docx
export/*.pdf
export/*.xlsx
export/*.png
export/*.log

# ── 日志与临时文件 ───────────────────────────
*.log
*.local
.env
.env.*

# ── 代码签名本地配置（含证书指纹，禁止提交）──
sign.config.json

# ── 外部设计库（独立克隆，含自己的 .git，不纳入本仓库）──
awesome-design-md/
